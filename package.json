{
  "name": "amberalex-parcel-locker-picker",
  "private": true,
  "scripts": {
    "build": "cp extensions/cart-locker-picker/assets/plp-cart.js extensions/cart-locker-picker/assets/plp-cart.css public/ && react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "cf-typegen": "wrangler types --strict-vars false",
    "sync:lockers": "tsx scripts/sync-lockers.ts",
    "preview": "vite preview",
    "deploy:worker": "wrangler d1 migrations apply amberalex-parcel-locker-picker --remote && wrangler deploy"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-api": "15.0.1",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-drizzle": "^6.0.1",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261027.1",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/polaris-types": "1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.5",
    "wrangler": "4.154.0"
  },
  "packageManager": "pnpm@12.16.1"
}
