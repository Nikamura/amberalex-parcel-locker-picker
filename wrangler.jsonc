{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amberalex-parcel-locker-picker",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat also fills process.env from vars and secrets.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "vars": {
    "SHOPIFY_APP_URL": "https://amberalex-parcel-locker-picker.karolis.workers.dev",
    "SHOPIFY_API_KEY": "e94c913beb6f1e4efd371daf77090f13",
    "SCOPES": "write_shipping,read_orders,write_orders"
  },
  // SHOPIFY_API_SECRET is a secret: `wrangler secret put SHOPIFY_API_SECRET`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amberalex-parcel-locker-picker",
      "database_id": "3128f36e-8b87-466c-89b4-9fe77886be83",
      "migrations_dir": "drizzle"
    }
  ]
}
