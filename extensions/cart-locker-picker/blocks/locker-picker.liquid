{% comment %}
  Parcel locker picker for the cart page and cart drawer. Adds a "Choose parcel
  locker" row next to the checkout button; the chosen locker is stored on cart
  lines (_plp_locker) and becomes the first shipping option at checkout.
{% endcomment %}
<script>
  window.ParcelLockerPicker = {
    appUrl: "https://amberalex-parcel-locker-picker.karolis.workers.dev",
    shop: {{ shop.permanent_domain | json }},
    locale: {{ request.locale.iso_code | json }},
    country: {{ localization.country.iso_code | json }},
    // Published by the app on settings save, so page views need no request to it.
    config: {{ app.metafields.plp.widget.value | json }},
  };
</script>
<link rel="stylesheet" href="{{ 'plp-cart.css' | asset_url }}">
<script src="{{ 'plp-cart.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Paštomatai",
  "target": "body",
  "settings": []
}
{% endschema %}
